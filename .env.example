# Copy this file to backend/.env and fill in real values. .env is ignored by git.
# NEVER put a real key in this example file.

# Which AI to use: "openai" (paid), "groq" (fast, free tier) or "ollama" (free, on your own PC).
LLM_PROVIDER=openai

# --- OpenAI (needs credits on platform.openai.com) ---
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Groq (fast hosted AI with a free tier; key from https://console.groq.com) ---
GROQ_API_KEY=your-key-here
# Model names change and differ per account: openai/gpt-oss-20b is fast and supports tools.
GROQ_MODEL=openai/gpt-oss-20b

# --- Ollama (free, no key; install Ollama and run: ollama pull qwen2.5:3b) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# A local model on a CPU can be slow, so the timeout is long (seconds).
OLLAMA_TIMEOUT_SECONDS=300

DATABASE_URL=sqlite:///./knowledge.db
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173

# Optional: LangSmith tracing (https://smith.langchain.com). OFF unless the flag is true AND
# a real key is set. Traces contain the text of your questions and records: use dummy data
# only, or set LANGSMITH_HIDE_DATA=true to send just the structure and timings.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=engineering-knowledge-agent
LANGSMITH_HIDE_DATA=false
# Leave empty for the LangSmith cloud. Set it for another region or a self-hosted server.
LANGSMITH_ENDPOINT=

# Where the agents' SYSTEM PROMPTS come from:
#   langsmith = pull eka-query, eka-update, eka-analysis and eka-router from LangSmith Prompt Hub
#               (needs a real LANGSMITH_API_KEY; if LangSmith cannot be reached the app logs a
#               warning and uses the files in backend/app/agents/prompts/ instead)
#   local     = always use those files
# Prompts are loaded once at start-up: restart the backend after editing one in LangSmith.
PROMPT_SOURCE=langsmith
# Empty = the latest commit of each prompt. Set a tag such as "production" to pin that version.
PROMPT_TAG=
