# Copy this file to backend/.env and fill in real values. .env is ignored by git.
# NEVER put a real key in this example file.

# Which AI to use: "openai" (a paid API) or "ollama" (a free model running on your own PC).
LLM_PROVIDER=openai

# --- OpenAI (needs credits on platform.openai.com) ---
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Ollama (free, no key; install Ollama and run: ollama pull qwen2.5:3b) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# A local model on a CPU can be slow, so the timeout is long (seconds).
OLLAMA_TIMEOUT_SECONDS=300

DATABASE_URL=sqlite:///./knowledge.db
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173

# Optional: LangSmith tracing (https://smith.langchain.com). Off unless you turn it on.
# Traces contain the text of your questions and records: use dummy data only.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=engineering-knowledge-agent
